# Copy to backend/.env for local development:  cp .env.example .env
# Never commit .env. Real staging and production values live in the hosting provider's secret store.

# local | test | staging | production
APP_ENV=local

# Postgres with pgvector. The default matches docker-compose.yml at the repo root.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/vibers

# Used only by the test suite; a separate database that tests may wipe.
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/vibers_test
